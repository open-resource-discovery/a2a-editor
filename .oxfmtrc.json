{
  "printWidth": 120,
  "quoteProps": "consistent",
  "bracketSameLine": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "dist-standalone",
    "website/build",
    "website/.docusaurus",
    "website/static/standalone",
    "node_modules",
    "package-lock.json",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-*/**",
    "**/.test-dist/**",
    "**/reports/**",
    "**/coverage/**",
    "**/.next/**",
    "**/build/**",
    "**/.docusaurus/**",
    "**/vendor/**",
    "**/generated/**",
    "**/examples/**",
    "**/fixtures/**",
    "**/original-schema/**",
    "**/__snapshots__/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/storybook-static/**",
    "**/.vscode-test/**",
    "**/example/**",
    "**/test-files/**",
    "**/resources/**",
    "**/schemas/**",
    "**/static/**",
    "**/res/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/.github/**"
  ]
}
