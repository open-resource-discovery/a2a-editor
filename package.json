{
  "name": "@open-resource-discovery/a2a-editor",
  "version": "0.4.7",
  "description": "Analyze, validate, and interact with Agent-to-Agent (A2A) protocol agent cards. Connect to agents, inspect their capabilities, and test communication in real-time.",
  "license": "Apache-2.0",
  "author": "SAP SE",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist-standalone/a2a-playground.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/a2a-editor.git"
  },
  "homepage": "https://github.com/open-resource-discovery/a2a-editor#readme",
  "bugs": {
    "url": "https://github.com/open-resource-discovery/a2a-editor/issues"
  },
  "keywords": ["a2a", "agent-to-agent", "agent-card", "editor", "react", "viewer"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lite": {
      "import": "./dist/playground-lite.js",
      "types": "./dist/playground-lite.d.ts"
    },
    "./viewer": {
      "import": "./dist/viewer.js",
      "types": "./dist/viewer.d.ts"
    },
    "./editor": {
      "import": "./dist/editor.js",
      "types": "./dist/editor.d.ts"
    },
    "./card-view": {
      "import": "./dist/card-view.js",
      "types": "./dist/card-view.d.ts"
    },
    "./styles": "./dist/index.css",
    "./standalone": "./dist-standalone/a2a-playground.js",
    "./standalone/css": "./dist-standalone/a2a-playground.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.css",
    "dist/index.d.ts",
    "dist/playground-lite.js",
    "dist/playground-lite.d.ts",
    "dist/viewer.js",
    "dist/viewer.d.ts",
    "dist/editor.js",
    "dist/editor.d.ts",
    "dist/card-view.js",
    "dist/card-view.d.ts",
    "dist/chunks",
    "dist/components/**/*.d.ts",
    "dist/hooks/**/*.d.ts",
    "dist/stores/**/*.d.ts",
    "dist/types/**/*.d.ts",
    "dist/utils/**/*.d.ts",
    "dist/mock/**/*.d.ts",
    "dist-standalone/a2a-playground.js",
    "dist-standalone/a2a-playground.css",
    "dist-standalone/a2a-initializer.js",
    "dist-standalone/index.html",
    "dist-standalone/standalone.html",
    "dist-standalone/index.cjs",
    "README.md"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "prepack": "npm run build",
    "dev": "vite",
    "start": "npm run website:start",
    "build": "npm run build:lib && npm run build:standalone",
    "build:lib": "tsc -b && vite build --mode lib && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/strip-css-from-dts.mjs",
    "build:lib:watch": "vite build --mode lib --watch",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:demo": "vite build",
    "copy:website-standalone": "node ./scripts/copy-standalone-to-website.mjs",
    "prepare:website-assets": "npm run build:standalone && npm run copy:website-standalone",
    "lint": "biome lint .",
    "eslint": "npm run lint",
    "eslint:ci": "npm run lint",
    "prettier": "npm run format",
    "prettier:ci": "npm run format:check",
    "format": "biome format --write . && oxfmt --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "format:check": "biome format . && oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "preview": "vite preview",
    "preview:standalone": "vite preview --outDir dist-standalone",
    "website": "npm --prefix website run start",
    "website:start": "npm --prefix website run start",
    "website:build": "npm --prefix website run build",
    "website:serve": "npm --prefix website run serve",
    "test:e2e": "npx playwright test",
    "test:e2e:vite": "npx playwright test --project=vite",
    "test:e2e:docusaurus": "npx playwright test --project=docusaurus",
    "test:e2e:ui": "npx playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "is-ci || husky",
    "lint:fix": "biome lint --write .",
    "check:tooling": "npm run lint && npm run format:check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@open-resource-discovery/specification": "1.17.1",
    "@open-resource-discovery/ui-components": "0.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.73.0",
    "react-markdown": "10.1.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "fflate": "0.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": ["biome check --write --no-errors-on-unmatched"],
    "*.{md,yml,yaml}": ["oxfmt"]
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "satori": "0.63.2",
    "tailwindcss": "4.3.5",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "playwright": "1.65.0",
    "react-resizable-panels": "4.23.0",
    "@biomejs/biome": "2.6.4",
    "oxfmt": "0.75.0"
  },
  "engines": {
    "node": "22.23.4",
    "npm": ">=10"
  }
}
