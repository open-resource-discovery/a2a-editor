# Keep dependency installs locked and save future additions as exact versions.
package-lock=true
save-exact=true

# Preserve runtime compatibility and the project peer-resolution policy.
# Keep engine checks advisory for the existing Node 22 CI coverage.
engine-strict=false

# Retain the project lifecycle-script and executable-link policy.
ignore-scripts=true
strict-allow-scripts=true

# Retain the project release-age and Git-dependency restrictions.
min-release-age=2

# Retain existing registry, authentication, and TLS settings.
strict-ssl=true

# Keep installs reproducible.
lockfile-version=3

# Enforce engine and peer requirements while retaining documented exceptions.
strict-peer-deps=true

# Keep installer output quiet and registry requests bounded.
fund=false
update-notifier=false
fetch-retries=5
fetch-timeout=60000
