# Keep dependency installs locked and save future additions as exact versions.
package-lock=true
save-exact=true

# Enforce declared runtime requirements and retain the project peer-resolution policy.
engine-strict=true

# Retain the project lifecycle-script and executable-link policy.
ignore-scripts=true
strict-allow-scripts=true

# Retain the project release-age and Git-dependency restrictions.
min-release-age=2

# Retain existing registry, authentication, and TLS settings.
strict-ssl=true
